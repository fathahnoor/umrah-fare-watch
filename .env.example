# Umrah Fare Watch - environment example.
# Names only. Never commit real tokens or credentials.

# HTTP server
PORT=3000
DB_PATH=./data/umrah-fare-watch.db
PUBLIC_DIR=./src/ui/public

# Mode: "true" runs deterministic mock providers without network or credentials.
MOCK_MODE=true

# Horizons (days)
USER_HORIZON_DAYS=365
TECHNICAL_FLIGHT_HORIZON_DAYS=370
MOCK_HOTEL_FRONTIER_DAYS=330

# Application bounds
MAX_FLIGHTS_FOR_HOTEL_ENRICHMENT_PER_SEARCH=5
MAX_HOTEL_RESULTS_PER_CITY=10
MAX_TRIP_PLANS_RETURNED=20
MAX_CONCURRENT_PROVIDER_REQUESTS=3
CALENDAR_SCAN_DAYS_MAX=30

# Alerts
ALERT_COOLDOWN_HOURS=24
MATERIAL_DROP_PERCENT=3

# Request cache TTL (ms)
REQUEST_CACHE_TTL_MS=900000

# Watchlist worker re-check interval (ms, min 10000)
WATCHLIST_WORKER_INTERVAL_MS=300000

# Real provider tokens are server-side only and are NEVER placed in this file.
# They will be injected through a secret manager when an adapter is enabled.
