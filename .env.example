# Umrah Fare Watch - environment example.
# Names only. Never commit real tokens or credentials.

# HTTP server
PORT=3000
DB_PATH=./data/umrah-fare-watch.db
PUBLIC_DIR=./src/ui/public

# Mode: "true" runs deterministic mock providers without network or credentials.
MOCK_MODE=true

# Horizons (days)
USER_HORIZON_DAYS=365
TECHNICAL_FLIGHT_HORIZON_DAYS=370
MOCK_HOTEL_FRONTIER_DAYS=330

# Application bounds
MAX_FLIGHTS_FOR_HOTEL_ENRICHMENT_PER_SEARCH=5
MAX_HOTEL_RESULTS_PER_CITY=10
MAX_TRIP_PLANS_RETURNED=20
MAX_CONCURRENT_PROVIDER_REQUESTS=3
CALENDAR_SCAN_DAYS_MAX=30

# Alerts
ALERT_COOLDOWN_HOURS=24
MATERIAL_DROP_PERCENT=3

# Request cache TTL (ms)
REQUEST_CACHE_TTL_MS=900000

# Watchlist worker re-check interval (ms, min 10000)
WATCHLIST_WORKER_INTERVAL_MS=300000

# Account sessions
SESSION_TTL_DAYS=30

# Real provider tokens are server-side only and are NEVER placed in this file.
# They will be injected through a secret manager when an adapter is enabled.
#
# --- Real provider activation gate (M5-M7) ---
# Master switch: "true" activates a real adapter ONLY when its token is present.
REAL_PROVIDERS_ENABLED=false
# Travelpayouts/Aviasales marketing token (M5). Verified 2026-08-12: the free
# tier only serves the search cache of Aviasales sites (mostly the ru market),
# so Indonesian routes (CGK->JED) return empty. Useful for RU-market trends;
# NOT usable as the live source for Indonesian umrah routes. Keeps its own
# opt-in flag: flip TRAVELPAYOUTS_ENABLED=true only after a route-aware smoke
# test for Indonesian routes passes (e.g. paid tier with ID market coverage).
# TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_ENABLED=false
# SerpAPI key (M6 Google Flights + M7 Google Hotels, replaces Duffel which does
# not accept Indonesian registrations). Covers Indonesian routes with real-time
# prices and booking links. Free tier: 250 searches/month. Sign up: serpapi.com
# SERPAPI_API_KEY=
# FX_API_KEY=          (optional free FX key; exchangerate.host free tier is
#                       ~1 request/hour, cached for FX_CACHE_TTL_MS, default 1h)
# FX_API_URL=https://api.exchangerate.host/live
# FX_CACHE_TTL_MS=3600000
#
# --- M8 booking handoff ---
# Comma-separated host allowlist. Only these hosts may be opened after the
# re-verify + price-confirm flow. Add google.com when SerpAPI handoff is live.
# Default: mock.example
# HANDOFF_ALLOWED_HOSTS=mock.example
